msgstr "Objednávky, ktoré sa nepodarilo prepočítať automaticky:"

msgid "Order #%1$d: %2$s"
msgstr "Objednávka #%1$d: %2$s"

msgid "The link has expired, please reload the page and try again."
msgstr "Odkaz exspiroval, načítajte stránku znova a skúste to ešte raz."

