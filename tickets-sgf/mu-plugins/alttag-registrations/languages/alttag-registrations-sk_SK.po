msgid "%s remaining"
msgstr "%s zostáva"

msgid "sold out at this price"
msgstr "za túto cenu vypredané"

msgid "Seats (0 = unlimited)"
msgstr "Miest (0 = neobmedzene)"

msgid "This event is sold out."
msgstr "Toto podujatie je vypredané."

msgid "We can no longer seat %1$d people together. Only %2$d single seats are left. Please register the people separately or contact us."
msgstr "Už nedokážeme usadiť %1$d ľudí spolu. Zostáva len %2$d jednotlivých miest. Zaregistrujte ich prosím samostatne alebo nás kontaktujte."

msgid "Grouped seating"
msgstr "Rozdelenie do skupín"

msgid "Place each booking into a group (station) within a wave."
msgstr "Zaradí každú registráciu do skupiny (stanovišťa) v rámci vlny."

msgid "Seats per group"
msgstr "Miest v skupine"

msgid "Total capacity = seats per group × number of groups."
msgstr "Celková kapacita = miest v skupine × počet skupín."

msgid "Group (seating)"
msgstr "Skupina (rozdelenie)"

msgid "This product does not use grouped seating."
msgstr "Tento produkt nepoužíva rozdelenie do skupín."

msgid "not assigned"
msgstr "nepriradené"

msgid "Wave %d%s"
msgstr "Vlna %d%s"

msgid "Moving somebody here does not check capacity. The numbers next to each group are shown so you can decide."
msgstr "Presun sem nekontroluje kapacitu. Čísla pri skupinách sú tu na to, aby ste sa rozhodli."

msgid "Group capacity"
msgstr "Obsadenosť skupín"

msgid "No product uses grouped seating yet. Enable it in the product Inventory tab."
msgstr "Žiadny produkt zatiaľ nepoužíva rozdelenie do skupín. Zapnete ho v záložke Sklad na produkte."

msgid "Booked: %1$d of %2$d"
msgstr "Obsadené: %1$d z %2$d"

msgid "No waves are configured for this product."
msgstr "Pre tento produkt nie sú nastavené vlny."

msgid "Wave"
msgstr "Vlna"

msgid "Booked"
msgstr "Obsadené"

msgid "%d seat"
msgid_plural "%d seats"
msgstr[0] "%d miesto"
msgstr[1] "%d miesta"
msgstr[2] "%d miest"

msgid "Free seats"
msgstr "Voľné"

msgid "podujatie"
msgstr "podujatie"

msgid "We can no longer keep %1$s together in this time slot - %2$s remain, but only separately. Please choose another time or register the people separately."
msgstr "V tomto čase už nedokážeme udržať %1$s spolu - ostáva síce %2$s, ale len jednotlivo. Vyberte prosím iný čas alebo zaregistrujte ľudí samostatne."

msgid "This time slot is sold out. Please choose another one."
msgstr "Tento časový slot je vypredaný. Vyberte prosím iný."

msgid "Only %1$s is left in this time, so we cannot fit your %2$s. Please choose another time."
msgstr "V tomto čase ostáva už len %1$s, preto doň vaše %2$s už nepomestíme. Vyberte prosím iný čas."

msgid "Assign each booking to a station inside the time slot it chose."
msgstr "Priradiť každú rezerváciu na stanovisko v rámci vybraného časového slotu."

msgid "Stations per time slot"
msgstr "Počet stanovísk na časový slot"

msgid "Seats per station = the time slot capacity divided by this number."
msgstr "Miesta na stanovisko = kapacita časového slotu delená týmto číslom."

msgid "No time slots are configured for this product."
msgstr "Tento produkt nemá nastavené žiadne časové sloty."

msgid "Moving somebody here does not check capacity. The numbers next to each station are shown so you can decide."
msgstr "Presun tu nekontroluje kapacitu. Čísla pri stanoviskách sú zobrazené preto, aby ste sa mohli rozhodnúť."

msgid "Split each time slot into stations and place every booking into one of them, keeping a booking together."
msgstr "Rozdelí každý časový slot na stanoviská a každú rezerváciu umiestni na jedno z nich tak, aby zostala pohromade."

msgid "Used when a product does not set its own number. The seats of a time slot are divided between them."
msgstr "Použije sa, keď produkt nemá vlastný počet. Miesta časového slotu sa medzi ne rozdelia."

msgid "Station names"
msgstr "Názvy stanovísk"

msgid "Comma separated, in order. Leave empty for A, B, C, ..."
msgstr "Oddelené čiarkou, v poradí. Prázdne = A, B, C, ..."

msgid "Planned for any day"
msgstr "Plánovaný na ktorýkoľvek deň"

msgid "Attended on any day"
msgstr "Zúčastnil sa v ktorýkoľvek deň"

